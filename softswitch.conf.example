# Softswitch installer settings.
# On first run this is copied to /etc/softswitch/softswitch.conf; edit that
# copy and re-run `sudo ./install.sh` to apply changes. Empty = auto-detect.

SS_HOSTNAME=""          # public FQDN of this switch (default: hostname -f)
SS_PUBLIC_IP=""         # default: source IP of the default route
SS_SSH_PORT=""          # default: read from sshd

# SIP / media
SS_PBX_PORT=5060        # PBX phones (digest auth), open to the internet
SS_PBX_TLS_PORT=5061
SS_PBX_WSS_PORT=7443    # WebRTC phones: FreeSWITCH WSS on loopback, proxied by nginx at wss://<host>/ws
SS_CARRIER_PORT=5080    # wholesale customers + vendors, allowlisted IPs only
SS_SELFTEST_PORT=5090   # built-in self-test vendor; never opened in the firewall
SS_RTP_START=16384
SS_RTP_END=32768

# Extra IPs/CIDRs always allowed to reach SS_CARRIER_PORT. Customer IPs and
# vendor gateways from the admin UI are added automatically.
SS_CARRIER_IPS=""

# Call handling
SS_MAX_CALL_DURATION=14400      # seconds; longest call allowed (funds are reserved for this)
SS_PROGRESS_TIMEOUT=10          # seconds to wait for a vendor to ring (180/183) before failing over
SS_ANSWER_TIMEOUT=60            # seconds a call may ring before giving up
SS_MAX_SESSIONS=1000            # FreeSWITCH concurrent call legs (2 per call)
SS_MAX_SESSIONS_PER_SECOND=100

# Disable SSH password and root login: auto = only if the installing
# user already has an SSH key set up (so you can't lock yourself out).
SS_HARDEN_SSH=auto      # auto | yes | no

# Source versions (built from public GitHub; no SignalWire token needed)
SS_FREESWITCH_REF=v1.11.3
SS_SOFIA_SIP_REF=v1.13.19
SS_SPANDSP_REF=v3.1.1
# Web admin UI (Laravel). nginx serves $SS_WEB_ROOT/public.
SS_WEB_ROOT=/var/www/html
SS_ADMIN_EMAIL=""        # first admin login (default: admin@<hostname>)

# Dashboard → App version compares this server with the latest GitHub release.
SS_UPDATE_REPO=""        # owner/name (default: key2comm/Junction)
SS_UPDATE_TOKEN=""       # only for a private repository: a GitHub token with read access
SS_APP_USER=softswitch  # system user that owns the app and runs PHP-FPM / queue workers

# High availability (optional): a backup server kept in sync with this one.
# On the main server:  SS_HA_ROLE="primary", SS_HA_PEER="<backup's IP>"
# On the backup:       SS_HA_ROLE="standby", SS_HA_PEER="<main's IP>",
#                      SS_HA_PASSWORD="<printed at the end of the main server's install>"
# Use the servers' private IPs when they share a private network.
# Give both the same SS_HOSTNAME: after a failover you point that DNS name at the backup.
SS_HA_ROLE=""            # "" (single server) | primary | standby
SS_HA_PEER=""            # the other server's IPv4 address
SS_HA_PASSWORD=""        # backup only

# PostgreSQL (local). The password is generated into /etc/softswitch/secrets.
SS_DB_NAME=softswitch
SS_DB_USER=softswitch

SS_BUILD_DIR=/usr/local/src/softswitch
SS_FS_PREFIX=/usr/local/freeswitch
