# Softswitch installer settings.
# On first run this is copied to /etc/softswitch/softswitch.conf; edit that
# copy and re-run `sudo ./install.sh` to apply changes. Empty = auto-detect.

SS_HOSTNAME=""          # public FQDN of this switch (default: hostname -f)
SS_PUBLIC_IP=""         # default: source IP of the default route
SS_SSH_PORT=""          # default: read from sshd

# SIP / media
SS_PBX_PORT=5060        # PBX phones (digest auth), open to the internet
SS_PBX_TLS_PORT=5061
SS_CARRIER_PORT=5080    # wholesale customers + vendors, allowlisted IPs only
SS_RTP_START=16384
SS_RTP_END=32768

# Space-separated IPv4 addresses/CIDRs allowed to reach SS_CARRIER_PORT.
SS_CARRIER_IPS=""

# Disable SSH password and root login: auto = only if the installing
# user already has an SSH key set up (so you can't lock yourself out).
SS_HARDEN_SSH=auto      # auto | yes | no

# Source versions (built from public GitHub; no SignalWire token needed)
SS_FREESWITCH_REF=v1.11.3
SS_SOFIA_SIP_REF=v1.13.19
SS_SPANDSP_REF=v3.1.1
# Web admin UI (Laravel). nginx serves $SS_WEB_ROOT/public.
SS_WEB_ROOT=/var/www/html
SS_ADMIN_EMAIL=""        # first admin login (default: admin@<hostname>)
SS_APP_USER=softswitch  # system user that owns the app and runs PHP-FPM / queue workers

# PostgreSQL (local). The password is generated into /etc/softswitch/secrets.
SS_DB_NAME=softswitch
SS_DB_USER=softswitch

SS_BUILD_DIR=/usr/local/src/softswitch
SS_FS_PREFIX=/usr/local/freeswitch
