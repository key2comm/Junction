<include>
  <!-- PBX users: one file per extension in pbx/, written by the app (PbxSync). -->
  <domain name="$${domain}">
    <params>
      <param name="dial-string" value="{presence_id=${dialed_user}@${dialed_domain}}${sofia_contact(internal/${dialed_user}@${dialed_domain})}"/>
    </params>
    <groups>
      <group name="default">
        <users>
          <X-PRE-PROCESS cmd="include" data="pbx/*.xml"/>
        </users>
      </group>
    </groups>
  </domain>
</include>
