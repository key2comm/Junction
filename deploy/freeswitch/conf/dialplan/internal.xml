<include>
  <!-- Unauthenticated calls on the internal profile are challenged (auth-calls);
       anything that still lands here is refused. Phones run context "pbx". -->
  <context name="internal">
    <extension name="refuse">
      <condition field="destination_number" expression="^.*$">
        <action application="respond" data="403 Forbidden"/>
      </condition>
    </extension>
  </context>
</include>
