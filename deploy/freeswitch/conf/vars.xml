<include>
  <!-- Rendered by install.sh from /etc/softswitch/softswitch.conf -->
  <X-PRE-PROCESS cmd="set" data="softswitch_public_ip=@SS_PUBLIC_IP@"/>
  <X-PRE-PROCESS cmd="set" data="domain=@SS_PUBLIC_IP@"/>
  <X-PRE-PROCESS cmd="set" data="carrier_sip_port=@SS_CARRIER_PORT@"/>
  <X-PRE-PROCESS cmd="set" data="internal_sip_port=@SS_PBX_PORT@"/>
  <X-PRE-PROCESS cmd="set" data="internal_tls_port=@SS_PBX_TLS_PORT@"/>
  <!-- Self-test vendor/customer (php artisan softswitch:selftest). Not opened in the firewall. -->
  <X-PRE-PROCESS cmd="set" data="selftest_sip_port=@SS_SELFTEST_PORT@"/>

  <!-- Carrier calls offer the caller's own codecs to the vendor (no transcoding);
       this list is what FreeSWITCH accepts from carriers. -->
  <X-PRE-PROCESS cmd="set" data="carrier_codecs=PCMU,PCMA,G729,G723,AMR,OPUS"/>
  <X-PRE-PROCESS cmd="set" data="internal_codecs=OPUS,G722,PCMU,PCMA"/>

  <!-- Routing behaviour, read by scripts/softswitch/route.lua -->
  <X-PRE-PROCESS cmd="set" data="softswitch_max_call_duration=@SS_MAX_CALL_DURATION@"/>
  <X-PRE-PROCESS cmd="set" data="softswitch_progress_timeout=@SS_PROGRESS_TIMEOUT@"/>
  <X-PRE-PROCESS cmd="set" data="softswitch_answer_timeout=@SS_ANSWER_TIMEOUT@"/>

  <X-PRE-PROCESS cmd="set" data="console_loglevel=info"/>
</include>
