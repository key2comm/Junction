<configuration name="switch.conf" description="Core">
  <cli-keybindings/>
  <default-ptimes/>
  <settings>
    <param name="colorize-console" value="false"/>
    <param name="dialplan-timestamps" value="false"/>
    <param name="max-db-handles" value="100"/>
    <param name="db-handle-timeout" value="10"/>
    <param name="max-sessions" value="@SS_MAX_SESSIONS@"/>
    <param name="sessions-per-second" value="@SS_MAX_SESSIONS_PER_SECOND@"/>
    <param name="loglevel" value="info"/>
    <param name="dump-cores" value="no"/>
    <param name="rtp-start-port" value="@SS_RTP_START@"/>
    <param name="rtp-end-port" value="@SS_RTP_END@"/>
    <param name="rtp-enable-zrtp" value="false"/>
  </settings>
</configuration>
