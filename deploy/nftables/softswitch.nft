#!/usr/sbin/nft -f
# Softswitch host firewall. Rendered by install.sh to /etc/nftables/softswitch.nft
# fail2ban manages its own table (inet f2b-table) and is not touched here.

destroy table inet softswitch
table inet softswitch {
	# Wholesale peers (customers AND vendors) allowed to reach the carrier profile.
	# Populated by softswitch-firewall into /etc/nftables/softswitch-carriers.nft.
	set carriers {
		type ipv4_addr
		flags interval
	}

	set carriers6 {
		type ipv6_addr
		flags interval
	}

	chain input {
		type filter hook input priority filter; policy drop;

		ct state established,related accept
		ct state invalid drop
		iif lo accept

		meta l4proto { icmp, ipv6-icmp } accept

		tcp dport @SS_SSH_PORT@ ct state new limit rate 15/minute burst 10 packets accept

		tcp dport { 80, 443 } accept

		# internal profile: PBX phones only (digest auth + fail2ban)
		udp dport @SS_PBX_PORT@ accept
		tcp dport { @SS_PBX_PORT@, @SS_PBX_TLS_PORT@ } accept

		# carrier profile: all wholesale traffic, allowlisted peers only
		ip saddr @carriers udp dport @SS_CARRIER_PORT@ accept
		ip saddr @carriers tcp dport @SS_CARRIER_PORT@ accept
		ip6 saddr @carriers6 udp dport @SS_CARRIER_PORT@ accept
		ip6 saddr @carriers6 tcp dport @SS_CARRIER_PORT@ accept

		# RTP
		udp dport @SS_RTP_START@-@SS_RTP_END@ accept

		counter drop
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
	}
}

include "/etc/nftables/softswitch-carriers.nft"
