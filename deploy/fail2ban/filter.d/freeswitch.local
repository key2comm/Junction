# Overrides for fail2ban's stock freeswitch filter.
[Definition]
# FreeSWITCH 1.10+ writes a CPU-idle field ("97.50%") after the timestamp,
# which the stock prefix doesn't allow for.
_pref_line = ^%(__prefix_line)s(?:(?:\d+-)?\d+-\d+ \d+:\d+:\d+\.\d+)?(?: ?\d+\.\d+%%)?
# Count only real failures. The stock "extra" mode also counts
# "auth challenge" lines, which every legitimate REGISTER produces.
mode = normal
