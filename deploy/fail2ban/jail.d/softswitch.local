# Rendered by install.sh to /etc/fail2ban/jail.d/softswitch.local
[DEFAULT]
banaction = nftables-multiport
banaction_allports = nftables-allports
bantime = 1h
bantime.increment = true
bantime.maxtime = 1w
findtime = 10m
maxretry = 5
ignoreip = 127.0.0.1/8 ::1

[sshd]
enabled = true
backend = systemd
port = @SS_SSH_PORT@

[freeswitch]
enabled = @SS_F2B_FREESWITCH@
filter = freeswitch
logpath = @SS_FS_PREFIX@/log/freeswitch.log
banaction = %(banaction_allports)s
maxretry = 5
