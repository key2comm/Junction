# Rendered by install.sh to /etc/systemd/system/softswitch-ha-promote.service
[Unit]
Description=Junction: promote this backup to the main server
After=postgresql.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/softswitch-ha promote

# --- Sandbox (light: it manages PostgreSQL, the app's settings and services as root).
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
