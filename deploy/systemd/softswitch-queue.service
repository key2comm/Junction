# Rendered by install.sh to /etc/systemd/system/softswitch-queue.service
[Unit]
Description=Junction queue worker (Laravel)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=@SS_APP_USER@
Group=@SS_APP_USER@
WorkingDirectory=@SS_WEB_ROOT@
ExecStart=/usr/bin/php artisan queue:work --sleep=3 --tries=3 --max-time=3600
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
