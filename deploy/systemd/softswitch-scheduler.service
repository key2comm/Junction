# Rendered by install.sh to /etc/systemd/system/softswitch-scheduler.service
[Unit]
Description=Junction task scheduler (Laravel)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=@SS_APP_USER@
Group=@SS_APP_USER@
WorkingDirectory=@SS_WEB_ROOT@
ExecStart=/usr/bin/php artisan schedule:work
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
