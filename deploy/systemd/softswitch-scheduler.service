# Rendered by install.sh to /etc/systemd/system/softswitch-scheduler.service
[Unit]
Description=Junction task scheduler (Laravel)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=@SS_APP_USER@
Group=@SS_APP_USER@
WorkingDirectory=@SS_WEB_ROOT@
# A restart (an update, a reboot) stops the tasks it had running in the
# background before they release their "already running" locks, and the backup
# check's lock would then block backups for up to 6 hours. Nothing from this
# scheduler can be running when it starts, so its leftover locks go first.
ExecStartPre=/usr/bin/php artisan schedule:clear-cache --no-interaction
ExecStart=/usr/bin/php artisan schedule:work
Restart=always
RestartSec=5

# --- Sandbox. This service runs the root helpers through sudo (certificates,
# firewall), and they run inside it: so no NoNewPrivileges, and /usr and /etc
# are read-only except the paths the app and those helpers change.
UMask=0027
ProtectSystem=full
ReadWritePaths=-@SS_FS_CONF@/sip_profiles/carrier -@SS_FS_CONF@/directory/pbx -@SS_FS_CONF@/acl -@SS_FS_GREETINGS@
ReadWritePaths=-/etc/nftables -/etc/fail2ban/jail.d -/etc/letsencrypt -/etc/softswitch/tls
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
