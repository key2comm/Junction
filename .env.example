# Copy to /etc/softswitch/softswitch.env (production) or .env (dev). Never commit the real file.
SS_DATABASE_URL=postgresql+psycopg://softswitch:CHANGE_ME@127.0.0.1/softswitch
# Shared secret FreeSWITCH uses (HTTP basic auth) for xml_curl and json_cdr callbacks
SS_FS_HTTP_SECRET=CHANGE_ME
# FreeSWITCH event socket
SS_ESL_HOST=127.0.0.1
SS_ESL_PORT=8021
SS_ESL_PASSWORD=CHANGE_ME
# Set to false only for local development (cookies sent over plain HTTP, firewall calls skipped)
SS_SECURE_COOKIES=true
SS_FIREWALL_ENABLED=true
SS_AUTH_LOG=/var/log/softswitch/auth.log
